{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "tsconfig": {
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "moduleResolution": "node"
      }
    }]
  },
  "testMatch": [
    "<rootDir>/tests/staging/**/*.integration.ts"
  ],
  "setupFiles": [
    "<rootDir>/tests/staging/setup-env.js"
  ],
  "maxWorkers": 1,
  "testTimeout": 60000
}
