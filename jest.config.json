{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "tsconfig": {
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "moduleResolution": "node"
      }
    }]
  },
  "testMatch": ["**/__tests__/**/*.test.ts", "**/__tests__/**/*.test.tsx"],
  "collectCoverageFrom": [
    "lib/**/*.ts",
    "app/api/**/*.ts",
    "!**/*.d.ts"
  ]
}
